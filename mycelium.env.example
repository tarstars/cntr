# Mycelium private settings. Copy this file to ~/.mycelium/.env (outside every repository; the
# extension reads it from there, and variables of the same name in the environment win).
# Never commit the real file. The token is not stored here: run "Mycelium: Configure Eliza…"
# and it goes to VS Code SecretStorage.

# OpenAI-compatible gateway used for routes of kind "eliza" in .mycelium/models.json
ELIZA_BASE_URL=https://your-gateway.example/v1
# Request header that carries the token, and the word before it ("<scheme> <token>")
ELIZA_AUTH_HEADER=Authorization
ELIZA_AUTH_SCHEME=Bearer
